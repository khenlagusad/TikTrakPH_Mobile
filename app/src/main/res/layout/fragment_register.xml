<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Blue Header: Consistent with Homepage and Login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="26dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@android:color/white" />

            <!-- Branding -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="TikTrakPH"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:fontFamily="@font/quicksand_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="TRAFFIC VIOLATION MANAGEMENT"
                android:textColor="#D5E2FF"
                android:textSize="10sp"
                android:letterSpacing="0.10" />

            <!-- Yellow Accent -->
            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_marginTop="20dp"
                android:background="@color/accent_yellow" />

            <!-- Page Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Create Your Account"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:fontFamily="@font/quicksand_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Register to manage your traffic violation records with TikTrakPH."
                android:textColor="#E0E9FF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/quicksand_regular" />

        </LinearLayout>

        <!-- Registration Form Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Registration Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#DCE6F7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Personal Information Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Personal Information"
                        android:textColor="@color/primary_dark"
                        android:textSize="19sp"
                        android:fontFamily="@font/quicksand_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Provide your personal and identification details."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/quicksand_regular" />

                    <!-- First Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="First Name"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textCapWords"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Last Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Last Name"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textCapWords"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Number -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Phone Number"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="phone"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Driver's License -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLicenseNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Driver's License Number"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLicenseNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Section Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="22dp"
                        android:background="#E8EDF5" />

                    <!-- Account Information Section -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account Information"
                        android:textColor="@color/primary_dark"
                        android:textSize="19sp"
                        android:fontFamily="@font/quicksand_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Create your username and password."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/quicksand_regular" />

                    <!-- Username -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Username"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Password"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Confirm Password"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/surface"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/text_secondary"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="@color/primary_dark"
                            android:fontFamily="@font/quicksand_medium" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Registration Feedback -->
                    <TextView
                        android:id="@+id/tvRegisterMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/danger"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:fontFamily="@font/quicksand_medium" />

                    <!-- Create Account Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="22dp"
                        android:text="Create Account"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:fontFamily="@font/quicksand_bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primary"
                        app:elevation="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Existing Account Link -->
            <TextView
                android:id="@+id/tvLoginLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="Already have an account? Log In"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:fontFamily="@font/quicksand_bold" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="TikTrakPH • Digital Traffic Services"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/quicksand_regular" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
