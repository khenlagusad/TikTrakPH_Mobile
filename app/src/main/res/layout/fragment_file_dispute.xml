<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="File a Dispute"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:fontFamily="@font/quicksand_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Provide the details of your concern regarding this traffic violation."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/quicksand_medium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/light_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TICKET REFERENCE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/quicksand_bold" />

                <TextView
                    android:id="@+id/tvDisputeReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="TK-000000"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:fontFamily="@font/quicksand_bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dispute Title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/quicksand_bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisputeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter the subject of your dispute"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:fontFamily="@font/quicksand_medium" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Explanation"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/quicksand_bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisputeExplanation"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:gravity="top|start"
                android:hint="Explain why you believe this ticket should be reviewed..."
                android:inputType="textCapSentences|textMultiLine"
                android:fontFamily="@font/quicksand_medium" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Please provide accurate and complete information. Your dispute will be marked as Pending after submission."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/quicksand_medium" />

        <TextView
            android:id="@+id/tvDisputeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:visibility="gone"
            android:fontFamily="@font/quicksand_semibold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitDispute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Submit Dispute"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="@font/quicksand_bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDispute"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="@font/quicksand_bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>
